<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="csrf-token" content="<%= csrfToken %>" />
		<title>Todo Application</title>
		<link rel="stylesheet" href="/css/styles.css" />
	</head>
    <body>
		<%- include('header.ejs') %>
        <h1>Sign in</h1>
        <form action="/session" method="post" id="loginForm">      
            <input type="hidden" name = "_csrf" value = "<%= csrfToken %>"/>  
            <label for="email">Email</label>
            <input type="text" name="email" placeholder="Email" id="loginEmail" />            
            <label for="password">Password</label>
            <input type="password" name="password" placeholder="Password" id="loginPassword" />
            <button type="submit" id="loginButton" disabled>Sign in</button>
        </form>
        <script>
            const loginForm = document.getElementById('loginForm');
            const loginButton = document.getElementById('loginButton');
            let loginFormTouched = false;

            // Enable button when form is touched
            loginForm.addEventListener('input', function() {
                loginFormTouched = true;
                const email = document.getElementById('loginEmail').value.trim();
                const password = document.getElementById('loginPassword').value.trim();
                
                // Enable button only if form is touched and all fields have values
                loginButton.disabled = !(loginFormTouched && email && password);
            });
        </script>
        <% if(messages && messages.error && messages.error.length > 0)  { %>
  <% for(var i=0; i<messages.error.length; i++) { %>
          <li> <%= messages.error[i] %></li>
  <% } %>
<% } %>
        <%- include('footer.ejs') %>
        </div>
    </body>
</html>