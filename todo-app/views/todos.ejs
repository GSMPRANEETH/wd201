<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="csrf-token" content="<%= csrfToken %>" />
		<title>Todo Application</title>
		<link rel="stylesheet" href="/css/styles.css" />
	</head>
    <body>
		<%- include('header.ejs') %>
      <%- include('notifications.ejs') %>
    <%- include('todo.ejs') %>
    <div class="todos-container">
        <% sections.forEach(section => { %>
  <h5>
    <%= section.title %> (<span id="<%= section.id %>"><%= section.items.length %></span>)
  </h5>
  <table>
    <% section.items.forEach(todo => { %>
      <tr>
        <td>
          <input
            id="todo-<%= todo.id %>"
            type="checkbox"
            <%= todo.completed ? "checked" : "" %>
            onclick="updateTodo(<%= todo.id %>)"
          >
        </td>
        <td style="display: flex; align-items: center; gap: 8px;">
          <label for="todo-<%= todo.id %>" style="margin-right: 8px;" class = "Todo-Item"><%= todo.title %></label>
          <a href="#" onclick="event.preventDefault(); deleteTodo(<%= todo.id %>)">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                 width="16" height="16" style="cursor: pointer;">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </a>
        </td>
      </tr>
    <% }) %>
  </table>
<% }) %>
    </div>
        <%- include('footer.ejs') %>
        </div>
        <a href="/signout">signout</a>
    </body>
    	<script>
  const csrfToken = document
    .querySelector('meta[name="csrf-token"]')
    .getAttribute("content");

  // Loading spinner SVG constant
  const LOADING_SPINNER_SVG = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="16" height="16">
    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" opacity="0.25"></circle>
    <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" opacity="0.75"></path>
  </svg>`;

  // Helper to show loading spinner in a table row
  function showLoadingInRow(row) {
    const originalContent = row.innerHTML;
    const colCount = row.cells.length;
    row.innerHTML = `<td colspan="${colCount}" style="text-align: center;">
      <span class="loading-spinner">${LOADING_SPINNER_SVG}</span>
    </td>`;
    return originalContent;
  }

  // Helper to restore original row content
  function restoreRowContent(row, originalContent) {
    row.innerHTML = originalContent;
  }

  function updateTodo(id) {
    const checkbox = document.getElementById(`todo-${id}`);
    const completed = checkbox.checked;

    // Show loading spinner
    const row = checkbox.closest('tr');
    const originalContent = showLoadingInRow(row);

    fetch(`/todos/${id}`, {
      method: "PUT",
      headers: {
        "Content-Type": "application/json",
        "CSRF-Token": csrfToken,
      },
      body: JSON.stringify({ completed, _csrf: csrfToken }),
    })
    .then(response => {
      if (response.ok) {
        window.location.reload();
      } else {
        // Restore original content on error
        restoreRowContent(row, originalContent);
        console.error("Failed to update todo:", response.status);
      }
    })
    .catch(error => {
      // Restore original content on error
      restoreRowContent(row, originalContent);
      console.error("Error updating todo:", error);
    });
  }

  function deleteTodo(id) {
    const row = document.getElementById(`todo-${id}`).closest('tr');
    
    // Show loading spinner
    const originalContent = showLoadingInRow(row);

    fetch(`/todos/${id}?_csrf=${csrfToken}`, {
      method: "DELETE",
    })
    .then((response) => {
      if (response.ok) {
        window.location.reload();
      } else {
        // Restore original content on error
        restoreRowContent(row, originalContent);
        console.error("Failed to delete todo:", response.status);
      }
    })
    .catch((error) => {
      // Restore original content on error
      restoreRowContent(row, originalContent);
      console.error("Error deleting todo:", error);
    });
  }

</script>
</html>